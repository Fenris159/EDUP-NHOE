!/include/
!/vr/
!/mac/
!/cmake/
!/verification/
!/third_party/
!/tools/
!/docs/
__pycache__/
*.pyc
*.dmp
*.mdmp
*.jsonl
*.log
*.nupkg
**/build/
**/dist/
